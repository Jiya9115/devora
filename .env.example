# Copy this file to .env and edit. Everything is optional.
# Without a .env file the app uses the defaults shown here.
PORT=3000

# Admin account created on the first run (log in with the email or the username).
ADMIN_EMAIL=admin@devora.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Devora@2026

# Optional: enables "Continue with Google" on the login page (see README, section 6)
GOOGLE_CLIENT_ID=

# Long random string used to sign login cookies. Generated automatically if empty.
SESSION_SECRET=

# local  = run submissions as child processes on this machine (fine for development)
# docker = run every submission in a throw-away container with no network (use on a server)
JUDGE_SANDBOX=local
JUDGE_DOCKER_IMAGE=eclipse-temurin:21-jdk
# How many submissions are judged in parallel (keep <= number of CPU cores)
JUDGE_CONCURRENCY=2
