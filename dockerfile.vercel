# Devora — Vercel container
# Node.js + OpenJDK 17 for the Java online judge

FROM node:22-bookworm-slim

# Install Java compiler/runtime required by the judge
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Node dependencies first for better layer caching
COPY package*.json ./
RUN npm ci --omit=dev

# Copy application
COPY . .

# Create writable application data directory
RUN useradd -m -u 10001 devora \
    && mkdir -p /app/data \
    && chown -R devora:devora /app

USER devora

ENV NODE_ENV=production
ENV DATA_DIR=/app/data
ENV JUDGE_SANDBOX=local
ENV JUDGE_CONCURRENCY=1

# Vercel supplies PORT at runtime.
# Do NOT hard-code PORT here.
EXPOSE 3000

CMD ["node", "--disable-warning=ExperimentalWarning", "server.js"]